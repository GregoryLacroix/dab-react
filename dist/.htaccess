# =====================================================================================================================
# .htaccess du SITE (React) : hébergement Apache / LiteSpeed (PlanetHoster, o2switch, OVH…)
# À placer à la racine du site (public_html). « npm run build » le copie automatiquement dans dist/.
# Chaque bloc est protégé par <IfModule> : si le serveur ne connaît pas un module, le bloc est ignoré (pas d'erreur 500).
# =====================================================================================================================

# --- 1. Application « une seule page » (le plus important) ---------------------------------------------------------
# Toute adresse qui n'est pas un vrai fichier (/produits, /panier, /en/shop…) renvoie index.html ; React Router affiche
# ensuite la bonne page. Sans cette règle, recharger une page donne une erreur 404.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Aperçus de partage (WhatsApp, Facebook, Messenger, iMessage, X, LinkedIn, Telegram, Discord, Slack…) : ces robots ne lancent pas
  # le JavaScript du site. Pour une FICHE PRODUIT, on les envoie vers une page de l'API qui contient les balises d'aperçu (nom, photo,
  # prix). Les visiteurs et Google ne sont pas concernés. Si l'adresse de l'API change, modifiez-la ci-dessous (2 lignes).
  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|facebot|meta-externalagent|whatsapp|twitterbot|linkedinbot|slackbot|slack-imgproxy|telegrambot|discordbot|pinterest|skypeuripreview|vkshare|redditbot) [NC]
  RewriteRule ^produits/([0-9]+)/?$ https://dab.api.gregory-lacroix-pf.com/api/share/products/$1?lang=fr [R=302,L]
  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|facebot|meta-externalagent|whatsapp|twitterbot|linkedinbot|slackbot|slack-imgproxy|telegrambot|discordbot|pinterest|skypeuripreview|vkshare|redditbot) [NC]
  RewriteRule ^en/shop/([0-9]+)/?$ https://dab.api.gregory-lacroix-pf.com/api/share/products/$1?lang=en [R=302,L]

  # Les vrais fichiers et dossiers (images, sitemap.xml, 404.html…) sont servis normalement
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  # Un fichier introuvable dans /assets/ reste une vraie 404 : après une mise en ligne, le navigateur ne reçoit pas du HTML
  # à la place d'un script (l'application affiche alors « Le site vient d'être mis à jour »)
  RewriteCond %{REQUEST_URI} !^/assets/
  RewriteRule ^ /index.html [L]
</IfModule>

# --- 2. Pages d'erreur du projet ------------------------------------------------------------------------------------
ErrorDocument 404 /404.html
ErrorDocument 500 /500.html

# --- 3. Types de fichiers ---------------------------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType font/woff2 .woff2
  AddType image/svg+xml .svg
  AddDefaultCharset UTF-8
</IfModule>

# --- 4. Compression (pages plus rapides) -------------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript
  AddOutputFilterByType DEFLATE application/json application/manifest+json application/xml text/xml image/svg+xml
</IfModule>

# --- 5. Mémoire cache du navigateur ---------------------------------------------------------------------------------
<IfModule mod_headers.c>
  # Les pages HTML (dont index.html) ne restent jamais en cache : elles désignent les fichiers de la dernière version du site
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Scripts, styles et polices de /assets/ : leur nom change à chaque version, on peut les garder un an
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Images et icônes : une semaine
  <FilesMatch "\.(png|jpe?g|webp|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

# --- 6. Protections de base ---------------------------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# --- 7. HTTPS (désactivé volontairement) ---------------------------------------------------------------------------------
# Activez plutôt « Forcer le HTTPS » dans l'espace PlanetHoster : le serveur est derrière un proxy, et une règle écrite ici
# peut provoquer une boucle de redirection. Si vous en avez vraiment besoin, déplacez ces trois lignes (sans les #) juste
# après « RewriteBase / » du bloc 1, avant la règle qui renvoie vers index.html :
# RewriteCond %{HTTPS} off
# RewriteCond %{HTTP:X-Forwarded-Proto} !https
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
